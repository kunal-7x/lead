# voice-agent-v2 environment variables
# Copy to .env and fill in real values. NEVER commit .env.

# ── LiveKit ──────────────────────────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_at_least_32_bytes_long_here
LIVEKIT_ROOM_NAME=agent-room

# ── STT (Sarvam) ─────────────────────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_MODE options: codemix (Hinglish), transcribe (pure Hindi), translate, verbatim
SARVAM_STT_MODE=codemix

# ── TTS (ElevenLabs) ─────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# ── TTS provider selection ────────────────────────────────────────────────────
# Set TTS_PREMIUM=1 to force ElevenLabs even when ctx.tts_premium=False
TTS_PREMIUM=0

# ── Sarvam TTS (speaker voice) ───────────────────────────────────────────────
SARVAM_TTS_SPEAKER=rahul

# ── LLM router + guardrail (for next unit: LlmRouterProcessor) ───────────────
LLM_ROUTER_URL=http://llm-router:8111
GUARDRAIL_URL=http://guardrail:8112

# ── Infra ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
EVENT_PUBLISHER=demo
