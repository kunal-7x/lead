<profile name="external">
  <settings>
    <param name="context" value="default"/>
    <param name="rtp-ip" value="$${local_ip_v4}"/>
    <param name="sip-ip" value="$${local_ip_v4}"/>
    <param name="sip-port" value="5060"/>
    <param name="codec-prefs" value="PCMU,PCMA"/>
    <param name="inbound-codec-negotiation" value="greedy"/>
    <param name="auth-calls" value="false"/>
    <param name="apply-inbound-acl" value="${SIP_APPLY_INBOUND_ACL}"/>
  </settings>

  <gateways>
    <!--
      Jio SIP trunk: IP-based registration, no username/password.
      Real Jio IP range: set JIO_GATEWAY_IP env → enable via ESL on startup.
      Disabled here (register=false) until credentials injected via ESL.
    -->
    <gateway name="jio">
      <param name="proxy" value="${JIO_GATEWAY_IP}"/>
      <param name="register" value="false"/>
      <param name="caller-id-in-from" value="false"/>
      <param name="contact-params" value=""/>
      <param name="expire-seconds" value="60"/>
      <param name="retry-seconds" value="30"/>
      <param name="ping" value="25"/>
      <param name="enabled" value="false"/>
    </gateway>

    <!--
      Airtel SIP trunk: fallback, credential-based registration.
      Disabled until AIRTEL_GATEWAY_HOST + credentials set via ESL.
    -->
    <gateway name="airtel">
      <param name="proxy" value="${AIRTEL_GATEWAY_HOST}"/>
      <param name="register" value="false"/>
      <param name="username" value="${AIRTEL_SIP_USER}"/>
      <param name="password" value="${AIRTEL_SIP_PASS}"/>
      <param name="expire-seconds" value="60"/>
      <param name="enabled" value="false"/>
    </gateway>
  </gateways>
</profile>
