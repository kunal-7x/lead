<configuration name="modules.conf" description="Modules">
  <modules>
    <!-- SIP signaling -->
    <load module="mod_sofia"/>

    <!-- WebSocket audio streaming to voice agent (L16 PCM, 8kHz) -->
    <load module="mod_audio_stream"/>

    <!-- Core dialplan and call control -->
    <load module="mod_dptools"/>
    <load module="mod_commands"/>
    <load module="mod_esf"/>

    <!-- Event socket (ESL) for Go control plane -->
    <load module="mod_event_socket"/>

    <!-- Codecs: G.711 (PCMU/PCMA) — native for Jio SIP, zero transcoding -->
    <load module="mod_g711"/>

    <!-- Logging -->
    <load module="mod_logfile"/>
    <load module="mod_console"/>
  </modules>
</configuration>
