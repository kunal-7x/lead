# LLM providers
# Default LLM = groq_llama (Groq Llama 3.3 70B, ~275 tok/s). Cerebras is fallback.
# LLM_BASE_URL is NOT set — groq backend uses its own URL directly.
# Active model is selectable at runtime via LLM_ACTIVE_MODEL (honored on restart
# when no Redis override is set). Valid voice models:
#   groq_llama      — Groq Llama 3.3 70B versatile (DEFAULT)
#   groq_instant    — Groq Llama 3.1 8B Instant (faster/cheaper)
#   cerebras_llama  — Cerebras gpt-oss-120b (reasoning_effort=none)
#   openrouter      — OpenRouter (last-resort fallback)
LLM_ACTIVE_MODEL=groq_llama
GROQ_API_KEY=__placeholder__
CEREBRAS_API_KEY=__placeholder__
OPENROUTER_API_KEY=__placeholder__
OPENAI_API_KEY=__placeholder__
ANTHROPIC_API_KEY=__placeholder__
