# STT realtime streaming engine: "disabled" (batch-only) | "sarvam" (Sarvam saaras:v3 realtime WS)
# PRODUCTION: set to "sarvam" to enable realtime Hindi transcription (streaming path)
STT_STREAMING_ENGINE=sarvam

# Gap-triggered filler: plays ONLY if first TTS audio hasn't started within FILLER_GAP_MS
# after speech_end. Fast turns stay silent. Default OFF — set FILLER_ENABLED=true to enable.
FILLER_ENABLED=false
FILLER_GAP_MS=2500
