MISTRAL_7B_VLLM_URL=__placeholder__

# Voice providers
ELEVENLABS_API_KEY=__placeholder__
SARVAM_API_KEY=__placeholder__
# Sarvam TTS model + speaker (bulbul:v3 requires different speakers — anushka is v2 only)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
# Sarvam streaming-TTS over WebSocket (bulbul:v3). DEFAULT false (safe REST path).
# true → first-audio ~0.3s (vs ~2.2s REST), but touches the real-time audio path:
# a regression means SILENT calls. Set on BOTH tts-router and voice-agent-worker.
# On any streaming error the worker auto-falls-back to the batch REST synth.
TTS_STREAMING_WS=true
# Sarvam WS PCM sample rate (bulbul:v3 streams 24000 Hz; worker resamples to 8k).
SARVAM_STREAM_SAMPLE_RATE=24000
