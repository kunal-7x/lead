# ===== Chatwoot production .env (famit.in / Axcrio white-label) =====
SECRET_KEY_BASE=
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# ----- URLs / branding (Tier 1 white-label) -----
FRONTEND_URL=https://chat.famit.in
FORCE_SSL=false
DEFAULT_LOCALE=en
INSTALLATION_NAME=Axcrio
BRAND_NAME=Axcrio
BRAND_URL=https://famit.in
WIDGET_BRAND_URL=https://famit.in
TERMS_URL=https://famit.in/terms
PRIVACY_URL=https://famit.in/privacy
LOGO_THUMBNAIL=https://chat.famit.in/brand-assets/logo_thumbnail.png
LOGO=https://chat.famit.in/brand-assets/logo.png
LOGO_DARK=https://chat.famit.in/brand-assets/logo_dark.png

# ----- Postgres -----
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=chatwoot

# ----- Redis -----
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ----- Mailer (SMTP placeholders — human to fill, see need.md) -----
MAILER_SENDER_EMAIL=Axcrio <support@famit.in>
SMTP_DOMAIN=famit.in
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# ----- Misc -----
ENABLE_ACCOUNT_SIGNUP=false
ACTIVE_STORAGE_SERVICE=local
RAILS_MAX_THREADS=5
